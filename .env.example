# --- 必須 ---
# 公開URL（末尾スラッシュなし）。メール内のリンクと決済後の戻り先に使う
APP_URL=https://app.example.com
# docker compose で HTTPS を終端するドメイン
DOMAIN=app.example.com

# --- メール（未設定だと、登録・パスワード再設定などのメールは送られない） ---
SMTP_URL=smtps://user:password@smtp.example.com
MAIL_FROM=Kintai <noreply@example.com>

# --- 課金（4つとも設定すると有効。未設定ならお申し込みは受け付けない） ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Stripe Tax で消費税を自動計算する場合のみ 1（Stripe 側の設定が必要）
STRIPE_AUTOMATIC_TAX=0
